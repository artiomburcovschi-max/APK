<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- зашифрованные логин/пароль и история оценок не уходят в облако -->
        <exclude domain="sharedpref" path="creds.xml" />
        <exclude domain="database" path="grades.db" />
    </cloud-backup>
    <device-transfer>
        <!-- при переносе напрямую на новый телефон: логин не переносим (ключ Keystore не переедет),
             историю оценок переносим -->
        <exclude domain="sharedpref" path="creds.xml" />
    </device-transfer>
</data-extraction-rules>