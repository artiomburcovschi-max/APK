<?xml version="1.0" encoding="utf-8"?>
<!-- Виджет «Урок сейчас». Только то, что разрешено в RemoteViews: LinearLayout, TextView, Chronometer. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_lesson"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/wTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Расписание"
        android:textColor="@color/wyg_text_primary"
        android:textSize="15sp"
        android:textStyle="bold" />

    <Chronometer
        android:id="@+id/wCountdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFeatureSettings="tnum"
        android:textColor="@color/wyg_primary"
        android:textSize="36sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/wCaption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/wyg_text_secondary"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/wNext"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/wyg_text_body"
        android:textSize="12sp" />
</LinearLayout>
