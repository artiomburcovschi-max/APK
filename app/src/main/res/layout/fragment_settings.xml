<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Тема оформления"
        android:textColor="@color/wyg_text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/rgTheme"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/rbThemeSystem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="Как в системе"
            android:textColor="@color/wyg_text_primary" />

        <RadioButton
            android:id="@+id/rbThemeLight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="Светлая"
            android:textColor="@color/wyg_text_primary" />

        <RadioButton
            android:id="@+id/rbThemeDark"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="Тёмная"
            android:textColor="@color/wyg_text_primary" />
    </RadioGroup>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="«Как в системе» повторяет тёмную или светлую тему телефона."
        android:textColor="@color/wyg_text_secondary"
        android:textSize="13sp" />
</LinearLayout>
