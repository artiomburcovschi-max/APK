<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/contentRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/wyg_surface"
        android:orientation="vertical">

        <!-- Заголовок экрана; справа значок аккаунта (меню toolbar_menu), слева стрелка «назад» только в подразделах -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/wyg_surface"
            app:navigationContentDescription="Назад"
            app:navigationIconTint="@color/wyg_text_primary"
            app:titleTextColor="@color/wyg_text_primary" />

        <!-- Вкладки детей: видны только если в аккаунте два ребёнка и больше -->
        <HorizontalScrollView
            android:id="@+id/childTabsScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/childTabs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingTop="4dp"
                android:paddingEnd="12dp"
                android:paddingBottom="8dp" />
        </HorizontalScrollView>

        <LinearLayout
            android:id="@+id/updateBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/wyg_accent_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvUpdate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/wyg_accent_text"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnUpdateDismiss"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:text="Позже" />
        </LinearLayout>

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/wyg_background" />

        <!-- Отступ от системной панели жестов уже даёт contentRoot (см. setupWindowInsets), поэтому свои отступы панель не добавляет -->
        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNav"
            style="@style/Widget.Agenda.BottomNav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/bottom_nav_menu"
            app:paddingBottomSystemWindowInsets="false"
            app:paddingLeftSystemWindowInsets="false"
            app:paddingRightSystemWindowInsets="false" />
    </LinearLayout>

    <!-- Скрытый движок. Размер НЕ нулевой: при 0x0 календарь портала (FullCalendar) не рисует уроки, и «Дневник»
         оставался пустым. 1280dp: портал видит ширину обычного компьютера, как в Chrome, где разбор проверялся.
         invisible: пользователь его не видит и не нажимает, но вёрстка и скрипты работают. -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="1280dp"
        android:layout_height="900dp"
        android:visibility="invisible" />
</FrameLayout>
