<?xml version="1.0" encoding="utf-8"?>
<!-- Предмет и число пропусков, под ним полоска относительно предмета с максимумом -->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    app:cardBackgroundColor="@color/wyg_surface"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvAbsSubject"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/wyg_text_primary"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvAbsCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:textColor="@color/wyg_text_body"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/absBarTrack"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_bar_track"
            android:orientation="horizontal">

            <View
                android:id="@+id/absBarFill"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:background="@drawable/bg_bar_fill" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
