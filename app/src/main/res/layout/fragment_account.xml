<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Вы вошли как"
        android:textColor="@color/wyg_text_secondary"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvAccountLogin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/wyg_text_primary"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvAccountType"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/wyg_text_secondary"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvAccountDosar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:lineSpacingExtra="3dp"
        android:textColor="@color/wyg_text_body"
        android:textSize="14sp"
        android:visibility="gone" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:lineSpacingExtra="3dp"
        android:text="Логин и пароль хранятся на этом телефоне в зашифрованном виде. История оценок, дневник, домашние задания и пропуски тоже хранятся только здесь."
        android:textColor="@color/wyg_text_body"
        android:textSize="14sp" />

    <Button
        android:id="@+id/btnLogout"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="24dp"
        android:text="Сменить аккаунт" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Смена аккаунта стирает логин, пароль и все сохранённые данные (оценки, дневник, пропуски) на этом телефоне."
        android:textColor="@color/wyg_text_secondary"
        android:textSize="13sp" />
</LinearLayout>
